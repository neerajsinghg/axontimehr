/api/v1/me/payslips
/api/v1/me/expenses
/api/v1/me/loans
/api/v1/me/performance
/api/v1/me/training
/api/v1/me/certifications
/api/v1/me/documents
/api/v1/me/requests
/api/v1/me/tasks
/api/v1/me/notifications
/api/v1/me/calendar

/api/v1/team
/api/v1/team/attendance
/api/v1/team/leave
/api/v1/team/approvals
