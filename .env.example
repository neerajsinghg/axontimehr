# AxonTimeHR Enterprise Master Environment Variables Template

# Application
APP_ENV=development
DEBUG=true
APP_DOMAIN=dev.axontimehr.com
API_DOMAIN=dev.axontimehr.com

# PostgreSQL Database
POSTGRES_DB=axontimehr
POSTGRES_USER=axontimehr
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_32CHARS
DATABASE_URL=postgresql+asyncpg://axontimehr:CHANGE_ME_IN_PRODUCTION_32CHARS@postgres:5432/axontimehr

# Redis Cache & Broker
REDIS_URL=redis://redis:6379/0

# JWT & Authentication Security
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_32BYTES_MINIMUM
CORS_ORIGINS=https://dev.axontimehr.com,http://localhost:5173

# AI Intelligence Platform
AI_ENABLED=true
AI_PROVIDER=MOCK_PROVIDER
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
